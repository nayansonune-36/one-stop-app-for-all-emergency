    <!-- Medical Screen -->
    <string name="screen_medical_title">आपातकालीन मेडिकल आईडी</string>
    <string name="screen_medical_placeholder">अपनी आपातकालीन चिकित्सा प्रोफ़ाइल कॉन्फ़िगर करें (रक्त समूह, गंभीर एलर्जी, चिकित्सा स्थिति और आपातकालीन संपर्क)। प्रथम उत्तरदाताओं के लिए ऑफ़लाइन उपलब्ध।</string>

    <!-- Bot Screen -->
    <string name="screen_bot_title">ट्राइएज इंटेलिजेंस बॉट</string>
    <string name="screen_bot_placeholder">तत्काल प्राथमिक चिकित्सा और आपातकालीन प्रश्न पूछें। ध्यान दें: एआई बॉट इंजन को ट्राइएज मॉडल से जुड़ने के लिए सक्रिय इंटरनेट कनेक्शन की आवश्यकता है।</string>
    <string name="screen_bot_offline_warning">आप वर्तमान में ऑफ़लाइन हैं। एआई बॉट से बात करने के लिए कृपया सेलुलर या वाई-फाई से पुनः कनेक्ट करें, या ऑफ़लाइन प्राथमिक चिकित्सा कार्ड का उपयोग करें।</string>

    <!-- SOS Screen -->
