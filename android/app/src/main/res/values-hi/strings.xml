    <!-- Mesh Permissions -->
    <string name="permission_required_title">ऑफ़लाइन मेश अनुमतियां</string>
    <string name="permission_required_desc">इंटरनेट बंद होने पर संकट संदेश रिले करने के लिए S.E.N.T.I.N.E.L. ब्लूटूथ, आस-पास के डिवाइस और लोकेशन का उपयोग करता है। आपके आपातकालीन ट्रिगर के बिना कोई भी व्यक्तिगत डेटा अपलोड नहीं किया जाता है।</string>
