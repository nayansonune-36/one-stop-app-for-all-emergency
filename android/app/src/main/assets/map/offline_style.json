{
  "version": 8,
  "name": "SENTINEL Dark Offline",
  "metadata": {
    "maplibre:autogenerated": false
  },
  "center": [91.75, 26.15],
  "zoom": 11,
  "sources": {
    "guwahati_basemap": {
      "type": "geojson",
      "data": "asset://map/guwahati_basemap.geojson"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0B1220"
      }
    },
    {
      "id": "urban_zone",
      "type": "fill",
      "source": "guwahati_basemap",
      "filter": ["==", "kind", "urban_zone"],
      "paint": {
        "fill-color": "#121A2B",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "urban_zone_stroke",
      "type": "line",
      "source": "guwahati_basemap",
      "filter": ["==", "kind", "urban_zone"],
      "paint": {
        "line-color": "#1E2A40",
        "line-width": 1.5
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "guwahati_basemap",
      "filter": ["==", "kind", "water"],
      "paint": {
        "fill-color": "#182C48",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "highways",
      "type": "line",
      "source": "guwahati_basemap",
      "filter": ["==", "kind", "highway"],
      "paint": {
        "line-color": "#334D6E",
        "line-width": 3.0
      }
    },
    {
      "id": "arterials",
      "type": "line",
      "source": "guwahati_basemap",
      "filter": ["==", "kind", "arterial"],
      "paint": {
        "line-color": "#283C56",
        "line-width": 2.0
      }
    }
  ]
}
