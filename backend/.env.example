# S.E.N.T.I.N.E.L. Backend Environment Configuration (.env.example)
# Copy to .env and set your OpenAI API key before starting.

# Server listening port (default: 8080)
PORT=8080

# LLM Provider configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI API Key (Required - server will fail at startup if missing)
# Format: sk-proj-... or sk-...
LLM_API_KEY=

# Optional: Custom endpoint URL
# LLM_BASE_URL=https://api.openai.com/v1/chat/completions
