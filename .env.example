# ==============================================================================
# S.E.N.T.I.N.E.L. Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your values. Never commit .env to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Go Emergency Dispatch Backend Configuration
# ------------------------------------------------------------------------------
# Port for the HTTP backend server to listen on (default: 8080)
PORT=8080

# Bind host (default: 0.0.0.0)
BACKEND_HOST=0.0.0.0

# Public or LAN endpoint where mobile clients send SOS mesh digests
SENTINEL_BACKEND_URL="http://10.0.2.2:8080"

# ------------------------------------------------------------------------------
# 2. AI Triage LLM Configuration (OpenAI)
# ------------------------------------------------------------------------------
# LLM Provider: must be "openai" (or "mock" for offline testing)
LLM_PROVIDER=openai

# OpenAI Chat Model: fast, cost-efficient small model suitable for emergency first aid
# Default: gpt-4o-mini
LLM_MODEL=gpt-4o-mini

# OpenAI API Key: Required for server startup. The server will fail to start if not set.
# Obtain your key from: https://platform.openai.com/api-keys
# NEVER commit your real API key to version control or share it.
LLM_API_KEY=

# Optional: Override base URL for custom completions endpoint or proxy
# LLM_BASE_URL="https://api.openai.com/v1/chat/completions"

# ------------------------------------------------------------------------------
# 3. Map Tiles Configuration (BuildConfig: TILES_BASE_URL, TILES_API_KEY)
# ------------------------------------------------------------------------------
# IMPORTANT USAGE POLICY:
# The app MUST NEVER fetch raster or vector tiles from tile.openstreetmap.org
# (OpenStreetMap's tile usage policy strictly prohibits bulk or mobile app use).
#
# Option A: Self-hosted PMTiles on Object Storage (Recommended for cost & privacy)
# Host an India extract PMTiles file (e.g. india.pmtiles generated via pmtiles CLI)
# on Cloudflare R2, AWS S3, or any HTTP server supporting byte-range requests (206 Partial Content).
# Enable CORS for GET requests with headers: Range, If-Match.
TILES_BASE_URL="https://tiles.example.org/india.pmtiles"
TILES_API_KEY=""

# Option B: Commercial Vector Tile Provider (MapTiler, Stadia, Protomaps Cloud)
# Provide the vector URL template (format: {z}/{x}/{y}.pbf) and your secure API key.
# TILES_BASE_URL="https://api.maptiler.com/tiles/v3/{z}/{x}/{y}.pbf?key="
# TILES_API_KEY=""
